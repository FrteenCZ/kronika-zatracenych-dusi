views:
  - type: table
    name: Tabulka
    filters:
      and:
        - "!type.isEmpty()"
        - file.folder != "Templates"
    groupBy:
      property: status
      direction: ASC
    groupOrder:
      - todo
      - stub
      - done
    order:
      - file.name
      - date
      - status
      - type
      - katedra
    sort:
      - property: type
        direction: DESC
      - property: date
        direction: ASC
  - type: table
    name: Zobrazení
